{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2023"
    ],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#host": [
        "./test/hosts/cloudflare.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/global-setup.ts",
    "test/lib",
    "src/local",
    "test/hosts/local.ts",
    "test/unit/local-queue.test.ts",
    "test/unit/boundary-host.test.ts",
    "test/unit/cli.test.ts",
    "test/unit/check-traces.test.ts",
    "test/model"
  ]
}
